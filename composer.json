{
    "name": "watchtower15/sdk",
    "description": "The WatchTower15 PHP SDK: the framework-independent core.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://docs.watchtower15.com",
    "support": {
        "source": "https://github.com/watchtower15/watchtower15-php",
        "email": "contact@watchtower15.com"
    },
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "ext-json": "*",
        "composer-runtime-api": "^2.2",
        "guzzlehttp/psr7": "^2.7 || ^3.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0"
    },
    "suggest": {
        "ext-zlib": "Lets the SDK gzip ingest bodies; without it plain JSON is sent",
        "ext-apcu": "Lets ApcuStore keep minute buckets in shared memory (one host, one SAPI)",
        "ext-redis": "Lets RedisStore use phpredis",
        "predis/predis": "Lets RedisStore use Predis"
    },
    "bin": [
        "bin/watchtower15"
    ],
    "autoload": {
        "psr-4": {
            "WatchTower15\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WatchTower15\\Tests\\": "tests/"
        }
    }
}
